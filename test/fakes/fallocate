#!/bin/sh
# fallocate's fake (test/run.sh), as setup.sh calls it (-l <size> <file>):
# the real one, so the free space drops as on a server, but past the free
# space of the file's filesystem it fails as the real one does on ext4 and
# XFS, the file left with what fit.
echo "fallocate $*" >>/tmp/swap.calls
size=$(numfmt --from=iec "$2")
free=$(df --output=avail -B1 "$(dirname "$3")" | tail -n 1 | tr -d " ")
if [ "$size" -gt "$free" ]; then
  truncate -s "$free" "$3"
  echo "fallocate: fallocate failed: No space left on device" >&2
  exit 1
fi
exec /usr/bin/fallocate -l "$2" "$3"
