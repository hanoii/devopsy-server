#!/bin/sh
# rm's fake (test/run.sh): the kernel unlinks no file it swaps on (EPERM,
# may_delete's IS_SWAPFILE), which swapon's fake lists by inode in
# /tmp/swaps; everything else to the real one.
for f in "$@"; do
  case $f in
    /swapfile*)
      if [ -f /tmp/swaps ] && [ -e "$f" ] && grep -qx "$(stat -c %i "$f")" /tmp/swaps; then
        echo "rm: cannot remove '$f', a swap file that is on: Operation not permitted" >&2
        exit 1
      fi
      ;;
  esac
done
exec /bin/rm "$@"
